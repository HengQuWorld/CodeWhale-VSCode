# Source code (already bundled into dist/extension.js by webpack)
src/**
node_modules/**

# Build configuration (not needed at runtime)
tsconfig.json
webpack.config.js
vitest.config*

# Test infrastructure
.vitest/**
coverage/**
*.profraw

# Documentation (not needed at runtime)
AGENTS.md
design-language.md
debug-ide-plugin-freeze.md
troubleshooting-ide-plugin-freeze.md

# Docs and demo media (guides + recordings — never shipped; keeps the VSIX ~200 KB)
docs/**

# Package lock & gitignore (not needed at runtime)
package-lock.json
.gitignore

# Source maps (save ~50% dist/ space)
dist/*.map
.trae/**
.codewhale/**
